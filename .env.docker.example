# Kopiraj u ".env" pored docker-compose.yml na NAS-u i popuni.

# Lozinka za Postgres kontejner (izmisli dugu, nasumičnu).
POSTGRES_PASSWORD=promeni-me

# Tajni ključ za login cookie. Generiši:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=promeni-ovo-u-dug-nasumican-string

# (Opciono) Email obaveštenja preko Resend-a — vidi docs/EMAIL.md
RESEND_API_KEY=
EMAIL_FROM=Godišnji odmori <onboarding@resend.dev>
